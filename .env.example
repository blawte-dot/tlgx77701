# === AI Provider (Google Gemini — free tier, no billing account needed) ===
GEMINI_API_KEY=

# === X (Twitter) — OAuth 1.0a, Read and Write permissions required ===
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_USERNAME=

# === Behavior ===
# Platform toggles — turn a platform off cleanly without touching code.
# X is OFF by default: as of 2026, X's "Free" tier ships with 0 posting
# credits, so posting fails with 402 CreditsDepleted until the developer
# account is funded. Flip to true once that's resolved.
ENABLE_X_PUBLISHING=false
ENABLE_TELEGRAM_PUBLISHING=true

# true = run the full pipeline (collect, score, generate) but do NOT publish anywhere
DRY_RUN=false

# Daily API/publishing budget guards (see src/costControl.mjs)
MAX_X_POSTS_PER_DAY=12
MAX_TELEGRAM_POSTS_PER_DAY=30
MAX_AI_CALLS_PER_DAY=120

# === Market data (free, no key required by default — CoinGecko public API) ===
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
